{
  "name": "sidekick-dm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A static Swift and WebAssembly browser proof for Sidekick DM.",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "build:native": "npm run bootstrap && node scripts/build-native.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "npm run bootstrap && node scripts/build.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "verify:browser": "node scripts/verify-browser-source.mjs",
    "verify:webmcp": "node scripts/verify-webmcp.mjs",
    "verify:generation": "node scripts/verify-generation-run.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "test:native": "swift test --package-path native",
    "test:js": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/chromium-smoke.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "check": "npm run acceptance"
  }
}
